# BROWSER
# chrome
# firefox
# safari
BROWSER=chrome
MWEB=false

#RUN BROWSER AS INCOGNITO/PRIVATE MODE = yes or no
PRIVATE=no

#SET DESKTOP BROWSER
#MAXIMIZE = yes or no
MAXIMIZE=no

#IF NO, SET RESOLUTION
WIDTH=1560
HEIGHT=935

#RUN AS HEADLESS = yes or no
HEADLESS=no

#PARALLEL COMPONENTS
IS_PARALLEL='false'
TAGS_TO_RUN=TAGS
SHUFFLE_BROWSER=no

#CONFIGURE MAXWAIT TIME
MAX_WAIT_TIME=7

#DEFAULT RESOLUTION FOR MWEB
MWEB_WIDTH=390
MWEB_HEIGHT=985

MWEB_USER_AGENT='Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Mobile/15E148 Safari/604.1'